rules_version = '2';
// Regole del database della lista della spesa.
// Chi apre l'app entra in modo anonimo e invisibile; può leggere e scrivere
// solo dentro una famiglia di cui conosce il codice (quello nel link d'invito).
// L'elenco di tutte le famiglie non è leggibile da nessuno.
service cloud.firestore {
  match /databases/{database}/documents {
    match /families/{fid} {
      allow get: if request.auth != null;
      allow create: if request.auth != null
                         && request.resource.data.name is string
                         && request.resource.data.name.size() <= 40;
      match /{coll}/{doc} {
        allow read, write: if request.auth != null && coll in ['items', 'members'];
      }
    }
  }
}
